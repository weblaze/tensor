{
  "name": "tensor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "poll": "node --env-file=.env.local --experimental-strip-types --no-warnings scripts/poll.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "webhook": "node --env-file=.env.local --experimental-strip-types --no-warnings scripts/set-webhook.ts",
    "check:ai": "node --experimental-strip-types --no-warnings scripts/check-fallback.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "next": "^15.5.28",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.156.0"
  }
}
